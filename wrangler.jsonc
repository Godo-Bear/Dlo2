// Cloudflare Workers config: serves Hoop Chaos as static assets, plus a small
// account API in worker.js for saving progress online.
// "name" must match the Worker you created in the Cloudflare dashboard.
{
  "name": "dlo2",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  }
  // To turn on ONLINE accounts, create a KV namespace (Dashboard > Storage & Databases >
  // Workers KV > Create, name it e.g. "hoopchaos-saves"), then add its ID here:
  //
  // ,"kv_namespaces": [ { "binding": "SAVES", "id": "PASTE_YOUR_KV_NAMESPACE_ID" } ]
  //
  // Without it the game still works and accounts are saved on each device instead.
}
